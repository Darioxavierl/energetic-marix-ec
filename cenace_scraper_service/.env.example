# Configuración de la aplicación
DEBUG=True
LOG_LEVEL=INFO

# Configuración de BD
DATABASE_URL=sqlite:///./cenace.db

# Configuración de CENACE
CENACE_URL=https://www.cenace.gob.ec/info-operativa/InformacionOperativa.htm
CENACE_TIMEOUT=10

# Configuración de scheduler
SCRAPER_INTERVAL_MINUTES=15

# Configuración de API
API_HOST=0.0.0.0
API_PORT=8001
API_RELOAD=True

# Configuración de Playwright
PLAYWRIGHT_HEADLESS=True
PLAYWRIGHT_TIMEOUT=30000
PLAYWRIGHT_WAIT_SELECTOR=.resumen-box.total
PLAYWRIGHT_WAIT_UNTIL=networkidle